<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.heeji.picket.repository.ShowLikesRepository">

    <select id="findByShowIdAndUserId" resultType="int">
        SELECT  COUNT(*) FROM show_likes WHERE show_id = #{showId} AND user_id = #{userId}
    </select>

    <select id="countByShowId" resultType="int">
        SELECT COUNT(*) FROM show_likes WHERE show_id = #{showId}
    </select>

    <select id="findByUserId" resultType="HashMap">
        SELECT * FROM show_likes WHERE user_id = #{userId}
    </select>

    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM show_likes WHERE user_id = #{userId}
    </select>

</mapper>